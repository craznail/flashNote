<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FlashNote" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFF8FAFC</item>
        <item name="android:statusBarColor">#FFF8FAFC</item>
        <item name="android:navigationBarColor">#FFF8FAFC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Theme.FlashNote.Transparent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
